#!/bin/sh
# Refuse commits that contain API keys or .env files.
# Enabled with: git config core.hooksPath scripts/git-hooks   (make setup does this)

status=0

if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' >/dev/null; then
  echo "pre-commit: refusing to commit a .env file" >&2
  status=1
fi

# Anthropic keys (sk-ant-…) and Flagsmith server-side / admin keys (ser.… / long tokens)
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -E 'sk-ant-[A-Za-z0-9]+[-_][A-Za-z0-9_-]{20,}|ser\.[A-Za-z0-9]{20,}' >/dev/null; then
  echo "pre-commit: staged changes contain what looks like an API key; remove it before committing" >&2
  status=1
fi

exit $status
