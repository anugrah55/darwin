# Copy to .env (never commit .env — the pre-commit hook refuses it).

# --- Claude API -------------------------------------------------------------------------------
# https://console.anthropic.com. Every call is checked against DARWIN_BUDGET_USD before it is sent.
ANTHROPIC_API_KEY=
DARWIN_BUDGET_USD=2.00

# --- Flagsmith, self-hosted (default) ---------------------------------------------------------
# `make flagsmith-up flagsmith-setup` writes this block for you.
FLAGSMITH_API_URL=http://localhost:8000
# The Flagsmith CLI scopes credentials by host: FLAGSMITH_API_KEY_<host>_<port> for self-hosted.
FLAGSMITH_API_KEY_localhost_8000=
FLAGSMITH_PROJECT=
# The environment's client-side key (Environment ID).
FLAGSMITH_ENVIRONMENT=
# The environment's server-side SDK key (ser.…), used by ShopBot's Brain.
FLAGSMITH_SERVER_KEY=
FLAGSMITH_EVENTS_URL=http://localhost:8000/api/
FLAGSMITH_DASHBOARD_URL=http://localhost:8000

# --- Flagsmith Cloud (instead of the block above) ---------------------------------------------
# FLAGSMITH_API_URL=https://api.flagsmith.com
# FLAGSMITH_API_KEY=                 # Organisation API key
# FLAGSMITH_PROJECT=
# FLAGSMITH_ENVIRONMENT=
# FLAGSMITH_SERVER_KEY=
# (leave FLAGSMITH_EVENTS_URL unset: the SDK sends events to Flagsmith Cloud)

# --- Optional ---------------------------------------------------------------------------------
# DARWIN_FLAG=shopbot_brain          # the flag that holds the agent's genome
# DARWIN_COACH_MODEL=claude-opus-5-5
# DARWIN_APPROVER=your-name          # recorded with every approval (default: your user name)
# SHOPBOT_URL=http://127.0.0.1:8100
# DARWIN_LAB_PORT=8200
# DARWIN_AUTO_CHECK_SECONDS=60       # how often the Lab reads Flagsmith's results during an experiment
